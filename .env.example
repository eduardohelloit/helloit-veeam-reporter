# Veeam Weekly Reporter — variáveis de ambiente
# Copie este arquivo para .env e ajuste os valores antes de subir com docker compose up

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=veeam_reporter
POSTGRES_USER=veeam
POSTGRES_PASSWORD=troque_esta_senha_forte_aqui

# ── Admin inicial (criado automaticamente se a tabela de usuários estiver vazia) ──
ADMIN_USERNAME=admin
ADMIN_PASSWORD=TroqueEstaSenh@2025
ADMIN_EMAIL=ti@suaempresa.com.br

# ── Sessão (opcional — se não definido, gerado automaticamente) ──────────────
# SESSION_SECRET=minimo-32-caracteres-aqui
